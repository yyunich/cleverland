# Cleverland API — настройки (скопируйте в .env и заполните)

# Адрес базы данных (SQLite по умолчанию)
DATABASE_URL=sqlite:///./cleverland.db

# Telegram-уведомления о новых заявках.
# Получите токен у @BotFather, chat_id — у @userinfobot или @getmyid_bot.
# Оставьте пустым, если уведомления не нужны.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Токен администратора: GET /api/applications?token=<токен>
ADMIN_TOKEN=cleverland-admin

# Разрешённые источники фронтенда через запятую
CORS_ORIGINS=http://localhost:3000
